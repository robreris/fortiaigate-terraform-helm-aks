# Dev subscription — copy to tfvars/dev.tfvars and fill in real values.
# Usage: terraform apply -var-file=tfvars/dev.tfvars

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

image_repository = "<acr-name>.azurecr.io/fortiaigate"

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

location            = "eastus"
resource_group_name = "fortiaigate-dev"
cluster_name        = "fortiaigate-dev"
image_tag           = "V8.0.0-build0024"
app_node_count      = 1

# ---------------------------------------------------------------------------
# GPU support
# ---------------------------------------------------------------------------

gpu_enabled        = true
gpu_node_vm_size   = "Standard_NC6s_v3"

# ---------------------------------------------------------------------------
# Ingress (Application Gateway Ingress Controller)
# ---------------------------------------------------------------------------

agic_enabled  = true
ingress_class = "azure-application-gateway"
internal      = false
ingress_host  = "fortiaigate.example.com"

# AGIC annotations. The chart's ingress template injects no AGIC defaults
# (only ALB/nginx/traefik defaults are baked in), so anything AGIC-specific
# must be set here. The values below cover the most common HTTPS setup:
#   - backend-protocol: chart services speak HTTPS (tls.enabled = true)
#   - ssl-redirect:     send HTTP -> HTTPS at the gateway
#   - health-probe-*:   AGIC defaults to GET / which fails for /api/ and /v1/;
#                       these per-path probes match what the EKS chart sets
#                       via ALB Service annotations.
#   - appgw-ssl-certificate: name of a cert imported into Application Gateway
#                            from Key Vault. Omit for self-signed cert from tls.tf.
ingress_annotations = {
  "appgw.ingress.kubernetes.io/backend-protocol"     = "https"
  "appgw.ingress.kubernetes.io/ssl-redirect"         = "true"
  "appgw.ingress.kubernetes.io/health-probe-path"    = "/"
  "appgw.ingress.kubernetes.io/health-probe-status-codes" = "200-399"
  # "appgw.ingress.kubernetes.io/appgw-ssl-certificate" = "<kv-cert-name>"
}

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

storage_size           = "100Gi"
storage_account_tier   = "Premium"
storage_account_kind   = "FileStorage"

# ---------------------------------------------------------------------------
# Licenses
# ---------------------------------------------------------------------------
# Node names are available after the cluster is created:
#   kubectl get nodes -o custom-columns=NAME:.metadata.name --no-headers
# AKS node names look like: aks-app-12345678-vmss000000

licenses = {
  # "aks-app-12345678-vmss000000" = "licenses/YOURNODE.lic"
}
